# NVIDIA VISTA-3D. Keys are read server-side by server/vista-proxy.mjs.
# Prefer names WITHOUT the VITE_ prefix so Vite cannot inline them into the client bundle.
NVIDIA_VISTA_API_KEY=nvapi-xxxxxxxx
NVIDIA_VISTA_FALLBACK_KEY=nvapi-xxxxxxxx

# Where to send inference. Defaults to a local NIM; the retired hosted endpoint
# (410 Gone since 2026-08-25) is only tried as a last resort.
# VISTA_INVOKE_URL=http://localhost:8000/v1/vista3d/inference

# Origin the model can reach to download an uploaded scan.
# Defaults to http://host.docker.internal:8788 (a NIM container on this machine).
# VISTA_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# VISTA_PROXY_PORT=8788
